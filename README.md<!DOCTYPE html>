    background: #250044;
}

h1 {
    font-size: 36px;
    color: #00ffff;
    margin-bottom: 8px;
}

header p {
    color: #ff8c00;
    font-size: 20px;
}

.card {
    margin: 20px 0;
    padding: 25px;
    border-radius: 20px;
    background: rgba(20, 0, 45, 0.9);
    border: 3px solid #ff00c8;
    box-shadow: 0 0 18px #00ffff;
}

h2 {
    color: #ff00c8;
}

p, li {
    font-size: 18px;
    line-height: 1.7;
    color: #7cff00;
}

ul {
    padding-left: 25px;
}

.org {
    border-color: #ff8c00;
    box-shadow: 0 0 18px #ff8c00;
}

.instagram {
    text-align: center;
    padding: 20px;
}

.instagram a {
    color: #00ffff;
    font-size: 20px;
    text-decoration: none;
}

footer {
    text-align: center;
    margin-top: 30px;
    padding: 20px;
    color: #ff00c8;
